<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">

    <ImageView
        android:id="@+id/widget_bg_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/widget_glitch"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:visibility="gone"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AVRORA.EXE"
            android:textColor="#A78BFA"
            android:textSize="11sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/widget_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--:--"
            android:textColor="#5EEAD4"
            android:textSize="44sp"
            android:fontFamily="monospace"
            android:shadowColor="#5EEAD4"
            android:shadowRadius="16" />

        <ImageView
            android:id="@+id/widget_time_img"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:adjustViewBounds="true"
            android:scaleType="fitStart"
            android:visibility="gone"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/widget_alarm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#E6E1F2"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:shadowColor="#000000"
            android:shadowRadius="4" />

        <TextView
            android:id="@+id/widget_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="будильников нет"
            android:textColor="#E6E1F2"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:shadowColor="#000000"
            android:shadowRadius="4" />

        <TextView
            android:id="@+id/widget_by"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#D946EF"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:shadowColor="#000000"
            android:shadowRadius="4" />
    </LinearLayout>
</FrameLayout>
